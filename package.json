{
  "name": "jfrog-request-center",
  "displayName": "JFrog Request Center",
  "description": "Write and run AQL queries and explore JFrog REST APIs without leaving VS Code.",
  "version": "0.2.1",
  "publisher": "loudstil",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/loudstil/jfrog-request-center.git"
  },
  "bugs": {
    "url": "https://github.com/loudstil/jfrog-request-center/issues"
  },
  "homepage": "https://github.com/loudstil/jfrog-request-center#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "jfrog",
    "artifactory",
    "aql",
    "rest api",
    "openapi"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jfrogRequestCenter.switchServer",
        "title": "Switch Server…",
        "category": "JFrog Request Center",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "jfrogRequestCenter.addServer",
        "title": "Add Server…",
        "category": "JFrog Request Center",
        "icon": "$(add)"
      },
      {
        "command": "jfrogRequestCenter.editServer",
        "title": "Edit Server…",
        "category": "JFrog Request Center",
        "icon": "$(edit)"
      },
      {
        "command": "jfrogRequestCenter.removeServer",
        "title": "Remove Server…",
        "category": "JFrog Request Center",
        "icon": "$(trash)"
      },
      {
        "command": "jfrogRequestCenter.configure",
        "title": "Configure Active Server",
        "category": "JFrog Request Center"
      },
      {
        "command": "jfrogRequestCenter.clearCredentials",
        "title": "Clear Access Token",
        "category": "JFrog Request Center"
      },
      {
        "command": "jfrogRequestCenter.openAqlManager",
        "title": "Open AQL Manager",
        "category": "JFrog Request Center"
      },
      {
        "command": "jfrogRequestCenter.newQuery",
        "title": "New AQL Query",
        "category": "JFrog Request Center",
        "icon": "$(add)"
      },
      {
        "command": "jfrogRequestCenter.openSavedQuery",
        "title": "Open Saved Query…",
        "category": "JFrog Request Center"
      },
      {
        "command": "jfrogRequestCenter.renameSavedQuery",
        "title": "Rename Saved Query…",
        "category": "JFrog Request Center",
        "icon": "$(edit)"
      },
      {
        "command": "jfrogRequestCenter.deleteSavedQuery",
        "title": "Delete Saved Query…",
        "category": "JFrog Request Center",
        "icon": "$(trash)"
      },
      {
        "command": "jfrogRequestCenter.executeRequest",
        "title": "Send API Request…",
        "category": "JFrog Request Center",
        "icon": "$(play)"
      },
      {
        "command": "jfrogRequestCenter.openRequestForm",
        "title": "Open Request Form…",
        "category": "JFrog Request Center",
        "icon": "$(edit)"
      },
      {
        "command": "jfrogRequestCenter.copyEndpointPath",
        "title": "Copy Endpoint Path",
        "category": "JFrog Request Center"
      },
      {
        "command": "jfrogRequestCenter.refreshApiExplorer",
        "title": "Reload OpenAPI Specs",
        "category": "JFrog Request Center",
        "icon": "$(refresh)"
      },
      {
        "command": "jfrogRequestCenter.showLogs",
        "title": "Show Logs",
        "category": "JFrog Request Center"
      }
    ],
    "configuration": {
      "title": "JFrog Request Center",
      "properties": {
        "jfrogRequestCenter.servers": {
          "type": "array",
          "default": [],
          "markdownDescription": "The JFrog Platform servers you can switch between. Access tokens are not stored here; they are kept in your OS keychain. Usually edited with **JFrog Request Center: Add Server**; can also be shared with a team in a workspace's `.vscode/settings.json`.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name, e.g. \"Production\"."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Platform URL, e.g. https://mycompany.jfrog.io"
              },
              "username": {
                "type": "string",
                "description": "Optional. When set, the token is sent with Basic auth."
              }
            }
          }
        },
        "jfrogRequestCenter.platformUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of your JFrog Platform, e.g. `https://mycompany.jfrog.io`.",
          "markdownDeprecationMessage": "Replaced by `jfrogRequestCenter.servers`. Migrated automatically."
        },
        "jfrogRequestCenter.username": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional username. When set, requests use Basic auth (`username:token`); otherwise the access token is sent as a Bearer token.",
          "markdownDeprecationMessage": "Replaced by `jfrogRequestCenter.servers`. Migrated automatically."
        },
        "jfrogRequestCenter.openApiSpecs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "OpenAPI 3 spec files (JSON or YAML) whose endpoints are added to the API Explorer, e.g. specs downloaded from the JFrog API reference. Paths may be absolute, start with `~/`, or be relative to the first workspace folder."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jfrogRequestCenter",
          "title": "JFrog Request Center",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "jfrogRequestCenter": [
        {
          "id": "jfrogRequestCenter.servers",
          "name": "Servers"
        },
        {
          "id": "jfrogRequestCenter.apiExplorer",
          "name": "API Explorer"
        },
        {
          "id": "jfrogRequestCenter.savedQueries",
          "name": "Saved Queries"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jfrogRequestCenter.savedQueries",
        "contents": "No saved queries yet. Write a query in the AQL Manager and click Save.\n[Open AQL Manager](command:jfrogRequestCenter.openAqlManager)"
      },
      {
        "view": "jfrogRequestCenter.servers",
        "contents": "Add the JFrog Platform servers you work with. You can switch between them at any time.\n[Add Server](command:jfrogRequestCenter.addServer)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jfrogRequestCenter.addServer",
          "when": "view == jfrogRequestCenter.servers",
          "group": "navigation"
        },
        {
          "command": "jfrogRequestCenter.newQuery",
          "when": "view == jfrogRequestCenter.savedQueries",
          "group": "navigation"
        },
        {
          "command": "jfrogRequestCenter.refreshApiExplorer",
          "when": "view == jfrogRequestCenter.apiExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jfrogRequestCenter.deleteSavedQuery",
          "when": "view == jfrogRequestCenter.savedQueries && viewItem == savedQuery",
          "group": "inline"
        },
        {
          "command": "jfrogRequestCenter.renameSavedQuery",
          "when": "view == jfrogRequestCenter.savedQueries && viewItem == savedQuery",
          "group": "1_modify@1"
        },
        {
          "command": "jfrogRequestCenter.deleteSavedQuery",
          "when": "view == jfrogRequestCenter.savedQueries && viewItem == savedQuery",
          "group": "1_modify@2"
        },
        {
          "command": "jfrogRequestCenter.executeRequest",
          "when": "view == jfrogRequestCenter.apiExplorer && viewItem == endpoint",
          "group": "inline"
        },
        {
          "command": "jfrogRequestCenter.executeRequest",
          "when": "view == jfrogRequestCenter.apiExplorer && viewItem == endpoint",
          "group": "1_send@1"
        },
        {
          "command": "jfrogRequestCenter.openRequestForm",
          "when": "view == jfrogRequestCenter.apiExplorer && viewItem == endpoint",
          "group": "1_send@2"
        },
        {
          "command": "jfrogRequestCenter.copyEndpointPath",
          "when": "view == jfrogRequestCenter.apiExplorer && viewItem == endpoint",
          "group": "2_copy@1"
        },
        {
          "command": "jfrogRequestCenter.editServer",
          "when": "view == jfrogRequestCenter.servers && viewItem =~ /^server/",
          "group": "inline"
        },
        {
          "command": "jfrogRequestCenter.switchServer",
          "when": "view == jfrogRequestCenter.servers && viewItem == server",
          "group": "1_server@1"
        },
        {
          "command": "jfrogRequestCenter.editServer",
          "when": "view == jfrogRequestCenter.servers && viewItem =~ /^server/",
          "group": "1_server@2"
        },
        {
          "command": "jfrogRequestCenter.clearCredentials",
          "when": "view == jfrogRequestCenter.servers && viewItem =~ /^server/",
          "group": "2_token@1"
        },
        {
          "command": "jfrogRequestCenter.removeServer",
          "when": "view == jfrogRequestCenter.servers && viewItem =~ /^server/",
          "group": "3_remove@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
